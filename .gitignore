node_modules/
dist/
*.log
.DS_Store
.worktrees/
.env
.env.*
!.env.example
tmp/

# macOS / Xcode build artifacts
build/
DerivedData/
xcuserdata/
*.xcuserstate
*.xcworkspace/xcuserdata/

# Local media artifacts — videos/audio are large and shouldn't be tracked.
# PNGs are intentionally NOT ignored here: app icons (Assets.xcassets) and
# doc images are tracked. Keep throwaway media under tmp/ (ignored above).
*.mp4
*.mov
*.wav

# Fixtures opt-in: explicitly track these if added later
!packages/quietcut-core/__fixtures__/*.mp4
