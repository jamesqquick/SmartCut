{
  "name": "quietcut-server",
  "version": "0.2.2",
  "private": true,
  "description": "JSON-RPC stdio sidecar around quietcut-core for the SmartCut macOS app.",
  "type": "module",
  "bin": {
    "quietcut-server": "./dist/server.cjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "execa": "^9.5.2",
    "quietcut-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
