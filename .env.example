# SmartCut env vars — loaded by the quietcut-core LLM gateway.
# Copy this file to .env and fill in real values.
# .env is gitignored.

# --- Cloudflare AI Gateway ---------------------------------------------------

# Cloudflare account ID. Required.
CLOUDFLARE_ACCOUNT_ID=

# AI Gateway ID. "default" auto-creates on first authenticated request.
CF_AIG_GATEWAY_ID=default

# --- Auth (choose one) -------------------------------------------------------

# Preferred: Unified Billing via AI Gateway.
# Create the token in: AI Gateway > your gateway > Settings >
#   Create authentication token (Cloudflare API token, AI Gateway "Run" perm).
# When this is set, do NOT also set ANTHROPIC_API_KEY.
CF_AIG_TOKEN=

# Alternative: bring-your-own Anthropic key. Leave unset if using CF_AIG_TOKEN.
# ANTHROPIC_API_KEY=
